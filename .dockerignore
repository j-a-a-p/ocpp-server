# Keeps the build context small and, more important, keeps secrets and personal
# data out of the images.
.git
.vscode
**/.DS_Store

# Local secrets and production data
infra/.hetzner.env
backups

# Built or installed on the image itself
**/node_modules
**/dist
**/__pycache__
**/*.pyc
**/*.db
**/.venv
**/flyway.conf.local

doc
